{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-RAVICHANDAN"
		},
		"LINKEDSERVICEDL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LINKEDSERVICEDL'"
		},
		"LINKEDSERVICEDL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ravistoragedatafactory.dfs.core.windows.net/"
		},
		"Linked_git_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"Mantrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/c44137e0-807b-470b-8d2c-0616ee78f1f7/resourceGroups/ADF_FULL_COURSE/providers/Microsoft.Storage/storageAccounts/ravistoragedatafactory"
		},
		"manager_trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/c44137e0-807b-470b-8d2c-0616ee78f1f7/resourceGroups/ADF_FULL_COURSE/providers/Microsoft.Storage/storageAccounts/ravistoragedatafactory"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-RAVICHANDAN_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LINKEDSERVICEDL_accountKey": {
						"value": "[parameters('LINKEDSERVICEDL_accountKey')]"
					},
					"LINKEDSERVICEDL_properties_typeProperties_url": {
						"value": "[parameters('LINKEDSERVICEDL_properties_typeProperties_url')]"
					},
					"Linked_git_properties_typeProperties_url": {
						"value": "[parameters('Linked_git_properties_typeProperties_url')]"
					},
					"manager_trigger_properties_typeProperties_scope": {
						"value": "[parameters('manager_trigger_properties_typeProperties_scope')]"
					},
					"Mantrigger_properties_typeProperties_scope": {
						"value": "[parameters('Mantrigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}